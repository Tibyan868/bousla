# Copy this file to ".env" and fill in your own values. NEVER commit .env to GitHub.

# --- Flask ---
SECRET_KEY=put-a-long-random-string-here

# --- Database ---
# PostgreSQL (Render / Railway / Neon / Supabase...). "postgres://" is accepted too.
# Leave empty to use a local SQLite file (instance/bousala.db) for development.
DATABASE_URL=

# --- Admin panel (/admin/login) ---
ADMIN_USERNAME=ADMIN
ADMIN_PASSWORD=choose-a-strong-password

# --- AI Assistant (/assistant) ---
# Put YOUR key here. Leave empty and the assistant still works in offline (knowledge-base) mode.
# LLM_PROVIDER: anthropic | openai | gemini | groq | openrouter  (auto-detected from the key if empty)
LLM_PROVIDER=
LLM_API_KEY=
# Optional: override the model (defaults: anthropic=claude-haiku-4-5, openai=gpt-4o-mini,
# gemini=gemini-2.5-flash, groq=llama-3.3-70b-versatile)
LLM_MODEL=
